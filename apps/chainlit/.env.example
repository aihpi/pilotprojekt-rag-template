# =============================================================================
# Environment = secrets + infrastructure + which RAG config to load.
# Per-instance settings (models, collection, chunking, prompt, citations,
# starters) live in the YAML config — see config/default.yaml. Any variable
# below still OVERRIDES the YAML if set, but you rarely need to.
# =============================================================================

# Which RAG instance config to load (relative to apps/chainlit/).
# Default = the shipped example corpus (3 open-access papers) with all features
# on, so a fresh clone works immediately. Alternatives:
#   RAG_CONFIG=config/default.yaml   # neutral baseline, no features enabled
#   RAG_CONFIG=my-rag.yaml           # your own instance (gitignored)
RAG_CONFIG=examples/papers/rag.config.yaml

# --- LiteLLM gateway (secrets) ----------------------------------------------
# Any OpenAI-compatible endpoint (LiteLLM proxy, OpenAI, a local gateway, ...).
# NOTE: model names are gateway-specific — see the comments in the YAML config.
LITELLM_BASE_URL=http://localhost:4000
LITELLM_API_KEY=your-key

# --- Vector store ------------------------------------------------------------
# For a local (non-Docker) run. docker compose overrides this with the service
# name (http://qdrant:6333), so you never have to switch it back and forth.
QDRANT_URL=http://localhost:6333
QDRANT_API_KEY=

# --- docker compose host ports ----------------------------------------------
# Only the HOST side; container ports never change. Bump these if something else
# already listens there (another project's Qdrant/Postgres, a dev server on 8000).
# APP_PORT=8000
# QDRANT_PORT=6333
# POSTGRES_PORT=5432

# --- Native Chainlit persistence + auth -------------------------------------
# Host `postgres` is the docker-compose service name and only resolves INSIDE the
# compose network. Running the app directly on your machine? Use localhost:
#   DATABASE_URL=postgresql://chainlit:chainlit@localhost:5432/chainlit
# docker compose ignores this variable on purpose (it hardcodes the service name),
# so switching it does not break the Docker path. To point compose at an external
# database, set DOCKER_DATABASE_URL instead.
DATABASE_URL=postgresql://chainlit:chainlit@postgres:5432/chainlit
CHAINLIT_AUTH_SECRET=change-me-with-a-long-random-string
CHAINLIT_INIT_DB=true

# GitHub OAuth - Create app at https://github.com/settings/developers
OAUTH_GITHUB_CLIENT_ID=Iv1.abc123def456
OAUTH_GITHUB_CLIENT_SECRET=0123456789abcdef0123456789abcdef01234567

# Admin fallback authentication (optional, for local development without OAuth)
CHAINLIT_AUTH_USERNAME=admin
CHAINLIT_AUTH_PASSWORD=admin

# --- Chat history persistence + export --------------------------------------
CHAT_DB_PATH=./.chainlit/chat_history.sqlite3
CHAT_EXPORT_DIR=./.files/chat_exports

# --- Docker auto-ingestion ---------------------------------------------------
INGEST_RECREATE=false
INGEST_BATCH_SIZE=256
INGEST_MAX_BATCH_CHARS=20000
# Rewrites a docling-json PDF source's directory. docker-compose already sets this
# to the container path (/data/...); leave it UNSET locally, or point it at your
# real local export dir — otherwise local ingest of a docling-json source resolves
# to a non-existent /data path.
# INGEST_DOCLING_JSON_DIR=/data/data_docling_json_ocr

# --- Optional overrides (normally set in the YAML config instead) -----------
# CHAT_MODEL=gpt-oss-120b
# EMBED_MODEL=octen-embedding-8b
# FALLBACK_CHAT_MODEL=
# QDRANT_COLLECTION=documents
# TOP_K=5
# SCORE_THRESHOLD=0.0
# STREAMING_ENABLED=false
# MAX_TOOL_CALL_ROUNDS=12

# --- Langflow agent orchestration (optional) --------------------------------
LANGFLOW_ENABLED=false
LANGFLOW_BASE_URL=http://langflow:7860
LANGFLOW_FLOW_ID=
LANGFLOW_API_KEY=
